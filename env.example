# ── Welcome Joiner Bot configuration ────────────────────────────────────────

# 1) Bot token from @BotFather  (create a new bot with /newbot)
BOT_TOKEN=1234567890:AAAA-your-bot-token-here

# 2) [OPTIONAL — MULTI-USER bot hai]
#    ADMIN_IDS sirf unowned chats ke messages ke liye hai (super-admin notification).
#    Koi bhi user bot use kar sakta hai, sab apna data dekhta hai.
#    Purane single-user DB ka data is user id ke naam migrate hota hai.
#    Blank chhod sakte ho: ADMIN_IDS=
ADMIN_IDS=987654321

# 3) MongoDB — jagah jahan saara data save hoga
#    ✅ RECOMMENDED: MongoDB Atlas (free cloud) → data kabhi nahi khota,
#      VPS mar jaye tab bhi!  https://cloud.mongodb.com  → free M0 cluster
#      (aur wahan se "Connect" krke URI copy karo)
#    Local VPS ke liye: mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=welcome_joiner_bot

# 4) Backup (optional) — auto backups ki jagah
#    Har 24h me 1 backup, sirf 10 rakhe jaate hain
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=10
